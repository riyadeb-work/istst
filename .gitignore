# ==============================================================================
# 1. COMPOSER DEPENDENCIES & CONTRIBUTED CODE
# ==============================================================================
# Ignore vendor dependencies and executable binaries
/vendor/
/composer.phar
/drush.phar
/drupal.phar

# Ignore Drupal core (managed entirely by Composer)
/core/

# Ignore contributed modules, themes, profiles, and recipes downloaded via Composer
# Place all custom work in /modules/custom, /themes/custom, etc.
/modules/contrib/
/themes/contrib/
/profiles/contrib/
/recipes/contrib/
/libraries/

# ==============================================================================
# 2. USER-GENERATED FILES, UPLOADS & TEMPORARY DATA
# ==============================================================================
# Ignore upload directories and user-generated content across all multisites
/sites/*/files/
/sites/*/public/
/sites/*/private/
/sites/*/files-public/
/sites/*/files-private/

# Ignore temporary, cache, translation, and testing directories
/sites/*/tmp/
/sites/*/cache/
/sites/*/translations/
/sites/*/simpletest/

# Ignore settings files
sites/default/settings.php

# ==============================================================================
# 3. LOCAL & SENSITIVE SETTINGS FILES
# ==============================================================================
# Ignore local environment variables and secrets
.env
.env.*
!.env.example
*.local.php
*.local.yml

# Ignore site settings files that contain database credentials or local configs
/sites/*/*settings*.php
!/sites/*/default.settings.php

# Ignore site service files
/sites/*/*services*.yml
!/sites/*/default.services.yml
/sites/development.services.yml

# Ignore example configuration files generated by Drupal
/sites/example.settings.local.php
/sites/example.sites.php

# ==============================================================================
# 4. SCAFFOLDED DOCUMENTATION & PLACEHOLDERS
# ==============================================================================
# Ignore default text and example files generated by drupal/core-composer-scaffold
/example.gitignore
/modules/README.txt
/themes/README.txt
/profiles/README.txt
/INSTALL.txt
/LICENSE.txt

# ==============================================================================
# 5. IDE, OS & TOOLING ARTIFACTS
# ==============================================================================
# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and text editor configuration
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Frontend build artifacts (if compiling assets at root)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
