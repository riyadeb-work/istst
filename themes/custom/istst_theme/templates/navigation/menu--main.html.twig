{#
/**
 * @file
 * Override for the "Main navigation" (machine name: main) menu.
 *
 * Renders the SAME menu tree twice from one Drupal menu:
 *  1. Desktop hover-dropdown nav (hidden below lg)
 *  2. Mobile slide-in drawer with accordions (hidden lg and up)
 *
 * Editors only ever maintain one menu (Admin > Structure > Menus >
 * Main navigation). Two levels are supported (top-level + one level
 * of dropdown children), matching the approved design.
 *
 * Available variables:
 * - items: nested menu link tree, each with .title, .url, .below.
 */
#}

{# ============== DESKTOP NAV ============== #}
<nav class="hidden lg:flex items-center space-x-1">
  {% for item in items %}
    <div class="relative group">
      <a href="{{ item.url }}" class="nav-trigger flex items-center text-primary font-medium px-4 py-2.5 rounded-full transition-all duration-200">
        {{ item.title }}
        {% if item.below %}
          <i class="fa-solid fa-chevron-down ml-1.5 text-[10px] transition-transform duration-200 group-hover:rotate-180 group-hover:text-secondary"></i>
        {% endif %}
      </a>
      {% if item.below %}
        <div class="dropdown-menu hidden absolute left-0 top-full w-56 pt-3">
          <div class="relative bg-white rounded-xl shadow-xl ring-1 ring-black/5 py-2 overflow-hidden">
            <span class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-secondary to-primary"></span>
            {% for child in item.below %}
              <a href="{{ child.url }}" class="nav-dropdown-link">{{ child.title }}</a>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  {% endfor %}
</nav>

{# ============== MOBILE DRAWER ============== #}
<div id="mobile-menu" class="fixed inset-y-0 right-0 w-64 bg-white shadow-2xl z-50 overflow-y-auto lg:hidden">
  <div class="p-5 flex justify-end">
    <button id="close-menu-btn" type="button" aria-label="Close menu" class="text-gray-500 hover:text-primary p-2">
      <i class="fa-solid fa-xmark text-2xl"></i>
    </button>
  </div>
  <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3 font-medium text-primary">
    {% for item in items %}
      {% if item.below %}
        <div class="mobile-dropdown">
          <button type="button" class="mobile-dropdown-toggle w-full text-left px-3 py-3 border-b border-gray-100 flex justify-between items-center">
            {{ item.title }} <i class="fa-solid fa-chevron-down text-xs"></i>
          </button>
          <div class="hidden pl-6 py-2 space-y-2 bg-gray-50">
            {% for child in item.below %}
              <a href="{{ child.url }}" class="block text-sm text-gray-600 py-1">{{ child.title }}</a>
            {% endfor %}
          </div>
        </div>
      {% else %}
        <a href="{{ item.url }}" class="block px-3 py-3 border-b border-gray-100">{{ item.title }}</a>
      {% endif %}
    {% endfor %}
  </div>
</div>

{# Backdrop overlay behind the mobile drawer #}
<div id="menu-overlay" class="fixed inset-0 bg-black/20 z-40 hidden lg:hidden backdrop-blur-sm transition-opacity"></div>
