{#
/**
 * @file
 * ISTST theme override of Drupal core's html.html.twig.
 *
 * Adds Google Fonts, FontAwesome and the Tailwind CDN engine + inline
 * theme config in <head>, exactly matching the approved static build.
 */
#}
<html{{ html_attributes }}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

  <head-placeholder token="{{ placeholder_token }}">
  <title>{{ head_title|safe_join(' | ') }}</title>

  {# --- Basic SEO Meta Tags --- #}
  <meta name="description" content="Indian Society of Thoracic Surgeons & Trust (ISTST)" />
  <meta name="author" content="ISTST" />

  {# --- Open Graph (OG) Tags --- #}
  <meta property="og:site_name" content="Indian Society of Thoracic Surgeons & Trust" />
  <meta property="og:title" content="{{ head_title|safe_join(' | ') }}" />
  <meta property="og:description" content="Indian Society of Thoracic Surgeons & Trust (ISTST)" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="/themes/custom/istst_theme/images/logo_small.png" />

  {# --- Twitter Card Tags --- #}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ head_title|safe_join(' | ') }}" />
  <meta name="twitter:description" content="Indian Society of Thoracic Surgeons & Trust (ISTST)" />
  <meta name="twitter:image" content="/themes/custom/istst_theme/images/logo_small.png" />

  {# Google Fonts #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">

  {# FontAwesome icons #}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  {# Tailwind CDN (JIT engine) + theme config. Kept head-blocking and
     inline (not via the library system) so it runs before first paint,
     identical to the static file. TODO for production: replace with a
     compiled Tailwind build + purge, see README.md. #}
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            heading: ['Poppins', 'sans-serif'],
          },
          colors: {
            primary: '#0F4D61',
            secondary: '#3AA6B9',
            accent: '#2997AA',
            lightbg: '#E9F8F9',
            dark: '#0F172A',
            textgray: '#454F5E'
          }
        }
      }
    }
  </script>

  <css-placeholder token="{{ placeholder_token }}">
  <js-placeholder token="{{ placeholder_token }}">
</head>
<body{{ attributes.addClass('font-sans text-textgray bg-slate-50 overflow-x-hidden') }}>
  <a href="#main-content" class="visually-hidden focusable">
    {{ 'Skip to main content'|t }}
  </a>
  {{ page_top }}
  {{ page }}
  {{ page_bottom }}
  <js-bottom-placeholder token="{{ placeholder_token }}">
</body>
</html>
