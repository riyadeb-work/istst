{#
/**
 * @file views-view--members.html.twig
 *
 * Wrapper override for the "members" View (all displays). Provides
 * the themed card/heading shell matching the rest of the site
 * (Member Registration, Committee, etc.) around Views' own
 * exposed-filter form, table, and pager output -- none of which are
 * touched/reimplemented here, just wrapped and styled via CSS in
 * style.css (search: "MEMBERS LIST VIEW STYLING").
 *
 * Available variables (standard Views template variables):
 * - title, header, exposed, attachment_before, rows, empty,
 *   attachment_after, more, pager, footer, feed_icons.
 */
#}
<section class="pt-32 md:pt-40 pb-12 md:pb-20 bg-lightbg min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    {# Page Title #}
    <div class="mb-6 md:mb-8">
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight">Members List</h1>
    </div>

    {# Main Content Card #}
    <div class="bg-white rounded-2xl shadow-md p-4 sm:p-6 md:p-8 lg:p-10 border border-gray-100">

      {{ header }}

      {% if exposed %}
        <div class="istst-members-filters mb-6 md:mb-8">
          {{ exposed }}
        </div>
      {% endif %}

      {{ attachment_before }}

      {% if rows %}
        {#
          ADDED: [&_table]:min-w-[600px] [&_table]:w-full
          This reaches into the {{ rows }} variable and forces the Drupal-generated
          <table> to be at least 600px wide. This prevents the columns from squishing
          and properly triggers the overflow-x-auto scroll on mobile devices.
        #}
        <div class="istst-members-table-wrap overflow-x-auto w-full rounded-lg border border-gray-100 [&_table]:min-w-[600px] [&_table]:w-full">
          {{ rows }}
        </div>
      {% elseif empty %}
        <div class="text-center text-textgray py-12 md:py-16">{{ empty }}</div>
      {% endif %}

      {{ attachment_after }}
      {{ more }}

      {% if pager %}
        <div class="istst-members-pager mt-8 md:mt-10 overflow-x-auto">
          {{ pager }}
        </div>
      {% endif %}

      {{ footer }}
    </div>

    {{ feed_icons }}
  </div>
</section>
