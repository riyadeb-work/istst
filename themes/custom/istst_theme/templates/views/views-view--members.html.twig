{#
/**
 * @file views-view--members.html.twig
 *
 * Wrapper override for the "members" View (all displays). Provides
 * the themed card/heading shell matching the rest of the site
 * (Member Registration, Committee, etc.) around Views' own
 * exposed-filter form, table, and pager output -- none of which are
 * touched/reimplemented here, just wrapped and styled via CSS in
 * style.css (search: "MEMBERS LIST VIEW STYLING").
 *
 * Available variables (standard Views template variables):
 * - title, header, exposed, attachment_before, rows, empty,
 *   attachment_after, more, pager, footer, feed_icons.
 */
#}
<section class="pt-32 md:pt-40 pb-12 md:pb-20 bg-lightbg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    {# Page Title #}
    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight">Members List</h1>
    </div>

    {# Main Content Card #}
    <div class="bg-white rounded-2xl shadow-md p-6 md:p-8 lg:p-10 border border-gray-100">

      {#
        NOTE: {{ title }} is intentionally not used here -- Views
        Page displays don't reliably populate this template variable
        (title is instead handled by Drupal core's "Page title"
        block, placed in the Content region above this view; see
        style.css "PAGE TITLE BLOCK" section for its styling).
      #}
      {{ header }}

      {% if exposed %}
        <div class="istst-members-filters mb-8">
          {{ exposed }}
        </div>
      {% endif %}

      {{ attachment_before }}

      {% if rows %}
        <div class="istst-members-table-wrap overflow-hidden rounded-lg border border-gray-100">
          {{ rows }}
        </div>
      {% elseif empty %}
        <div class="text-center text-textgray py-16">{{ empty }}</div>
      {% endif %}

      {{ attachment_after }}
      {{ more }}

      {% if pager %}
        <div class="istst-members-pager mt-10">
          {{ pager }}
        </div>
      {% endif %}

      {{ footer }}
    </div>

    {{ feed_icons }}
  </div>
</section>
